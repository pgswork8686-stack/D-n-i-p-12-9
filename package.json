{
  "name": "nexustheme-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @nexus/database prisma:generate",
    "db:migrate": "pnpm --filter @nexus/database prisma:migrate",
    "db:push": "pnpm --filter @nexus/database prisma:push",
    "db:seed": "pnpm --filter @nexus/database seed",
    "db:seed:system": "pnpm --filter @nexus/database seed:system",
    "db:seed:dev": "pnpm --filter @nexus/database seed:dev",
    "db:seed:catalog": "pnpm --filter @nexus/database seed:catalog",
    "db:seed:local": "pnpm --filter @nexus/database seed:local",
    "db:seed:all": "pnpm db:seed:system && pnpm db:seed:catalog",
    "worker:smoke": "pnpm --filter @nexus/worker test:smoke",
    "test:acceptance:phase4": "pnpm --filter @nexus/database acceptance:phase4",
    "test:acceptance:phase5": "pnpm --filter @nexus/database acceptance:phase5",
    "test:acceptance:phase6": "pnpm --filter @nexus/database acceptance:phase6",
    "test:acceptance:phase7": "pnpm --filter @nexus/database acceptance:phase7",
    "test:acceptance:phase8": "pnpm --filter @nexus/database acceptance:phase8",
    "test:acceptance:phase9": "pnpm --filter @nexus/database acceptance:phase9",
    "test:acceptance:phase10": "pnpm --filter @nexus/database acceptance:phase10",
    "test:acceptance:phase11": "pnpm --filter @nexus/database acceptance:phase11",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2"
  }
}
