datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  supabaseId String?  @unique @map("supabase_id")
  email      String?  @unique
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  profile            Profile?
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  carts              Cart[]
  orders             Order[]
  idempotencyKeys    IdempotencyKey[]
  entitlements       Entitlement[]
  licenseAllocations LicenseAllocation[]
  internalLicenses   InternalLicense[]
  licenseActivations LicenseActivation[]
  downloadEvents     DownloadEvent[]
  downloadGrants     DownloadGrant[]
  contentPosts       ContentPost[]
  subscriptions      Subscription[]
  affiliateAccount   AffiliateAccount?
  affiliateReferrals AffiliateReferral[]
  affiliateClicks    AffiliateClick[]
  hostingAccounts    HostingAccount[]
  tickets            Ticket[]            @relation("UserTickets")
  assignedTickets    Ticket[]            @relation("AssignedAdminTickets")
  ticketMessages     TicketMessage[]
  notifications      Notification[]

  @@map("users")
}

model Profile {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  displayName String?  @map("display_name")
  firstName   String?  @map("first_name")
  lastName    String?  @map("last_name")
  avatarUrl   String?  @map("avatar_url")
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?  @map("display_name")
  description String?
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String?  @map("display_name")
  module      String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedBy String?  @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String   @map("role_id")
  permissionId String   @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  actorId   String?  @map("actor_id")
  details   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model SystemHealthTest {
  id      String   @id @default(uuid())
  pingAt  DateTime @default(now()) @map("ping_at")
  service String   @default("api")

  @@map("system_health_tests")
}

// --------------------------------------------------------
// Phase 3 — Catalog & Product Models
// --------------------------------------------------------

enum ProductType {
  DOWNLOADABLE_ASSET
  LICENSED_SOFTWARE
  EXTERNAL_MANAGED_LICENSE
  MEMBERSHIP
  SUBSCRIPTION
  SERVICE
}

enum FulfillmentType {
  DIGITAL_DOWNLOAD
  INTERNAL_LICENSE
  EXTERNAL_MANAGED
  MEMBERSHIP_ACCESS
  MANUAL_SERVICE
  HOSTING_PROVISIONING
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CategoryStatus {
  ACTIVE
  ARCHIVED
}

enum Currency {
  VND
  USD
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum BillingInterval {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum MediaType {
  IMAGE
  GALLERY
  PREVIEW
  ICON
  THUMBNAIL
}

model Product {
  id               String          @id @default(uuid())
  slug             String          @unique
  name             String
  shortDescription String?         @map("short_description")
  description      String?
  productType      ProductType     @map("product_type")
  fulfillmentType  FulfillmentType @map("fulfillment_type")
  status           ProductStatus   @default(DRAFT)
  brand            String?
  metadata         Json?
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  variants     ProductVariant[]
  categories   ProductCategory[]
  media        ProductMedia[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  internalLicenses InternalLicense[]
  versions     ProductVersion[]
  downloadEvents DownloadEvent[]

  @@index([status])
  @@index([productType])
  @@index([fulfillmentType])
  @@map("products")
}

model ProductVariant {
  id            String        @id @default(uuid())
  productId     String        @map("product_id")
  sku           String        @unique
  name          String
  status        VariantStatus @default(ACTIVE)
  sortOrder     Int           @default(0) @map("sort_order")
  metadata      Json?
  licensePlanId String?       @map("license_plan_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  licensePlan  LicensePlan?   @relation(fields: [licensePlanId], references: [id], onDelete: SetNull)
  prices       ProductPrice[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  entitlements Entitlement[]
  internalLicenses InternalLicense[]

  @@index([productId])
  @@index([sku])
  @@index([licensePlanId])
  @@map("product_variants")
}

model ProductPrice {
  id              String           @id @default(uuid())
  variantId       String           @map("variant_id")
  currency        Currency
  amount          Int
  compareAtAmount Int?             @map("compare_at_amount")
  billingType     BillingType      @default(ONE_TIME) @map("billing_type")
  billingInterval BillingInterval? @map("billing_interval")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@index([variantId])
  @@index([isActive])
  @@map("product_prices")
}

model Category {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String?
  parentId    String?        @map("parent_id")
  sortOrder   Int            @default(0) @map("sort_order")
  status      CategoryStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryHierarchy")
  products ProductCategory[]

  @@index([slug])
  @@index([parentId])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductMedia {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  type       MediaType @default(IMAGE)
  url        String
  storageKey String?   @map("storage_key")
  altText    String?   @map("alt_text")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_media")
}

model LicensePlan {
  id             String   @id @default(uuid())
  name           String
  maxActivations Int      @default(1) @map("max_activations")
  durationDays   Int?     @map("duration_days")
  durationMonths Int?     @map("duration_months")
  updatesDays    Int?     @map("updates_days")
  supportDays    Int?     @map("support_days")
  isLifetime     Boolean  @default(false) @map("is_lifetime")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  variants ProductVariant[]

  @@map("license_plans")
}

// --------------------------------------------------------
// Phase 4 — Commerce Core Models
// --------------------------------------------------------

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMMITTED
  FAILED
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  status    CartStatus @default(ACTIVE)
  currency  Currency   @default(USD)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]
  orders Order[]

  @@index([userId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String   @map("cart_id")
  variantId String   @map("variant_id")
  priceId   String   @map("price_id")
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price   ProductPrice   @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId, priceId])
  @@index([cartId])
  @@index([variantId])
  @@index([priceId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(uuid())
  orderNumber    String      @unique @map("order_number")
  userId         String      @map("user_id")
  status         OrderStatus @default(PENDING_PAYMENT)
  currency       Currency
  subtotalAmount Int         @map("subtotal_amount")
  discountAmount Int         @default(0) @map("discount_amount")
  totalAmount    Int         @map("total_amount")
  cartId         String?     @unique @map("cart_id")
  metadata       Json?
  affiliateId    String?       @map("affiliate_id")
  affiliateCode  String?       @map("affiliate_code")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  cart              Cart?              @relation(fields: [cartId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  entitlements      Entitlement[]
  affiliateReferral AffiliateReferral?
  hostingAccounts   HostingAccount[]
  tickets           Ticket[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([affiliateId])
  @@map("orders")
}

model OrderItem {
  id                      String          @id @default(uuid())
  orderId                 String          @map("order_id")
  productId               String          @map("product_id")
  variantId               String          @map("variant_id")
  productName             String          @map("product_name")
  variantName             String          @map("variant_name")
  sku                     String
  productType             ProductType     @map("product_type")
  fulfillmentType         FulfillmentType @map("fulfillment_type")
  unitAmount              Int             @map("unit_amount")
  quantity                Int
  lineTotalAmount         Int             @map("line_total_amount")
  currency                Currency
  licensePlanIdAtPurchase String?         @map("license_plan_id_at_purchase")
  isLifetime              Boolean         @default(false) @map("is_lifetime")
  durationDays            Int?            @map("duration_days")
  durationMonths          Int?            @map("duration_months")
  maxActivations          Int?            @map("max_activations")
  updatesDays             Int?            @map("updates_days")
  supportDays             Int?            @map("support_days")
  snapshotVersion         Int?            @map("snapshot_version")
  metadata                Json?
  createdAt               DateTime        @default(now()) @map("created_at")

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  entitlement Entitlement?

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  provider          String
  providerReference String?       @map("provider_reference")
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          Currency
  metadata          Json?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@index([orderId])
  @@index([status])
  @@index([providerReference])
  @@map("payments")
}

model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String   @map("payment_id")
  provider        String
  eventType       String   @map("event_type")
  externalEventId String   @map("external_event_id")
  payload         Json
  rawPayloadHash  String?  @map("raw_payload_hash")
  createdAt       DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@index([externalEventId])
  @@map("payment_events")
}

model OutboxEvent {
  id            String            @id @default(uuid())
  eventType     String            @map("event_type")
  aggregateType String            @map("aggregate_type")
  aggregateId   String            @map("aggregate_id")
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  retryCount    Int               @default(0) @map("retry_count")
  error         String?
  lockOwner     String?           @map("lock_owner")
  lockedAt      DateTime?         @map("locked_at")
  nextAttemptAt DateTime?         @map("next_attempt_at")
  processedAt   DateTime?         @map("processed_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status])
  @@index([aggregateType, aggregateId])
  @@index([lockedAt])
  @@index([nextAttemptAt])
  @@map("outbox_events")
}

model IdempotencyKey {
  id                 String               @id @default(uuid())
  key                String
  scope              String
  userId             String               @map("user_id")
  requestFingerprint String               @map("request_fingerprint")
  response           Json?
  status             IdempotencyKeyStatus @default(IN_PROGRESS)
  startedAt          DateTime             @default(now()) @map("started_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  expiresAt          DateTime             @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, userId, key])
  @@index([expiresAt])
  @@index([status, startedAt])
  @@map("idempotency_keys")
}

// --------------------------------------------------------
// Phase 5 — Entitlement Engine Models
// --------------------------------------------------------

enum EntitlementStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model Entitlement {
  id              String            @id @default(uuid())
  userId          String            @map("user_id")
  orderId         String            @map("order_id")
  orderItemId     String            @unique @map("order_item_id")
  productId       String            @map("product_id")
  variantId       String            @map("variant_id")
  productType     ProductType       @map("product_type")
  fulfillmentType FulfillmentType   @map("fulfillment_type")
  status          EntitlementStatus @default(ACTIVE)
  quantity        Int               @default(1)
  activatedAt     DateTime          @default(now()) @map("activated_at")
  expiresAt       DateTime?         @map("expires_at")
  revokedAt       DateTime?         @map("revoked_at")
  maxActivations  Int?              @map("max_activations")
  updatesUntil    DateTime?         @map("updates_until")
  supportUntil    DateTime?         @map("support_until")
  subscriptionId  String?           @map("subscription_id")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem       OrderItem           @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  product         Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant         ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  subscription    Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  allocations     LicenseAllocation[]
  internalLicense InternalLicense?
  downloadEvents  DownloadEvent[]
  downloadGrants  DownloadGrant[]
  hostingAccount  HostingAccount?
  tickets         Ticket[]

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([productId])
  @@index([variantId])
  @@index([expiresAt])
  @@index([subscriptionId])
  @@index([status, expiresAt])
  @@map("entitlements")
}

// --------------------------------------------------------
// Phase 6 — Elementor External Managed License Models
// --------------------------------------------------------

enum LicenseFulfillmentMode {
  MANUAL_EXTERNAL
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum ProviderAccountStatus {
  ACTIVE
  EXHAUSTED
  SUSPENDED
}

enum AllocationStatus {
  PENDING
  ACTIVE
  DEACTIVATION_PENDING
  DEACTIVATED
  REJECTED
}

model LicenseProvider {
  id              String                 @id @default(uuid())
  code            String                 @unique
  name            String
  status          ProviderStatus         @default(ACTIVE)
  fulfillmentMode LicenseFulfillmentMode @default(MANUAL_EXTERNAL) @map("fulfillment_mode")
  metadata        Json?
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  accounts    ProviderAccount[]
  allocations LicenseAllocation[]

  @@map("license_providers")
}

model ProviderAccount {
  id                String                @id @default(uuid())
  providerId        String                @map("provider_id")
  name              String
  externalReference String?               @map("external_reference")
  totalCapacity     Int                   @map("total_capacity")
  status            ProviderAccountStatus @default(ACTIVE)
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  provider    LicenseProvider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  allocations LicenseAllocation[]

  @@index([providerId])
  @@index([status])
  @@map("provider_accounts")
}

model LicenseAllocation {
  id                String           @id @default(uuid())
  entitlementId     String           @map("entitlement_id")
  providerId        String           @map("provider_id")
  providerAccountId String?          @map("provider_account_id")
  userId            String           @map("user_id")
  domain            String
  normalizedDomain  String           @map("normalized_domain")
  status            AllocationStatus @default(PENDING)
  requestedAt       DateTime         @default(now()) @map("requested_at")
  activatedAt       DateTime?        @map("activated_at")
  deactivatedAt     DateTime?        @map("deactivated_at")
  metadata          Json?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  entitlement     Entitlement      @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  provider        LicenseProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  providerAccount ProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Restrict)
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entitlementId])
  @@index([providerId])
  @@index([providerAccountId])
  @@index([userId])
  @@index([status])
  @@index([normalizedDomain])
  @@map("license_allocations")
}

// --------------------------------------------------------
// Phase 7 — Internal License Engine Models
// --------------------------------------------------------

enum LicenseStatus {
  ACTIVE
  REVOKED
}

enum LicenseActivationStatus {
  ACTIVE
  DEACTIVATED
}

model InternalLicense {
  id            String        @id @default(uuid())
  entitlementId String        @unique @map("entitlement_id")
  userId        String        @map("user_id")
  productId     String        @map("product_id")
  variantId     String        @map("variant_id")
  status        LicenseStatus @default(ACTIVE)
  keyHash       String        @unique @map("key_hash")
  keyCiphertext String        @map("key_ciphertext")
  keyIv         String        @map("key_iv")
  keyAuthTag    String        @map("key_auth_tag")
  keyLast4      String        @map("key_last4")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  revokedAt     DateTime?     @map("revoked_at")

  entitlement Entitlement         @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  user        User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant     ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  activations LicenseActivation[]
  downloadGrants DownloadGrant[]

  @@index([userId])
  @@index([productId])
  @@index([variantId])
  @@index([status])
  @@map("internal_licenses")
}

model LicenseActivation {
  id               String                  @id @default(uuid())
  licenseId        String                  @map("license_id")
  userId           String                  @map("user_id")
  normalizedDomain String                  @map("normalized_domain")
  status           LicenseActivationStatus @default(ACTIVE)
  activatedAt      DateTime                @default(now()) @map("activated_at")
  deactivatedAt    DateTime?               @map("deactivated_at")
  lastValidatedAt  DateTime?               @map("last_validated_at")
  metadata         Json?
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  license InternalLicense @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  user    User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([licenseId])
  @@index([userId])
  @@index([status])
  @@index([normalizedDomain])
  @@map("license_activations")
}

// --------------------------------------------------------
// Phase 8 — Download & Version Engine Models
// --------------------------------------------------------

enum VersionStatus {
  DRAFT
  PUBLISHED
}

enum DownloadChannel {
  CUSTOMER_PORTAL
  LICENSE_UPDATER
}

model ProductVersion {
  id           String        @id @default(uuid())
  productId    String        @map("product_id")
  version      String
  status       VersionStatus @default(DRAFT)
  releaseNotes String?       @map("release_notes")
  releasedAt   DateTime?     @map("released_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  files          ProductVersionFile[]
  downloadEvents DownloadEvent[]
  downloadGrants DownloadGrant[]

  @@unique([productId, version])
  @@index([productId])
  @@index([status])
  @@index([productId, status])
  @@map("product_versions")
}

model ProductVersionFile {
  id               String    @id @default(uuid())
  productVersionId String    @map("product_version_id")
  storageKey       String    @unique @map("storage_key")
  fileName         String    @map("file_name")
  contentType      String    @default("application/zip") @map("content_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  isPrimary        Boolean   @default(false) @map("is_primary")
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  version        ProductVersion  @relation(fields: [productVersionId], references: [id], onDelete: Cascade)
  downloadEvents DownloadEvent[]
  downloadGrants DownloadGrant[]

  @@index([productVersionId])
  @@index([storageKey])
  @@map("product_version_files")
}

model DownloadEvent {
  id               String          @id @default(uuid())
  grantId          String?         @unique @map("grant_id")
  userId           String?         @map("user_id")
  entitlementId    String          @map("entitlement_id")
  productId        String          @map("product_id")
  productVersionId String          @map("product_version_id")
  fileId           String          @map("file_id")
  channel          DownloadChannel
  ipHash           String?         @map("ip_hash")
  userAgentHash    String?         @map("user_agent_hash")
  createdAt        DateTime        @default(now()) @map("created_at")

  grant          DownloadGrant?     @relation(fields: [grantId], references: [id], onDelete: SetNull)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  entitlement    Entitlement        @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  product        Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVersion ProductVersion     @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  file           ProductVersionFile @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([entitlementId])
  @@index([userId])
  @@index([productId])
  @@index([productVersionId])
  @@index([fileId])
  @@index([createdAt])
  @@map("download_events")
}

model DownloadGrant {
  id               String          @id @default(uuid())
  userId           String?         @map("user_id")
  entitlementId    String          @map("entitlement_id")
  productVersionId String          @map("product_version_id")
  fileId           String          @map("file_id")
  channel          DownloadChannel
  licenseId        String?         @map("license_id")
  normalizedDomain String?         @map("normalized_domain")
  issuedAt         DateTime        @default(now()) @map("issued_at")
  expiresAt        DateTime        @map("expires_at")

  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  entitlement    Entitlement        @relation(fields: [entitlementId], references: [id], onDelete: Restrict)
  productVersion ProductVersion     @relation(fields: [productVersionId], references: [id], onDelete: Restrict)
  file           ProductVersionFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  license        InternalLicense?   @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  downloadEvent  DownloadEvent?

  @@index([entitlementId, issuedAt])
  @@index([licenseId, issuedAt])
  @@index([fileId])
  @@map("download_grants")
}

