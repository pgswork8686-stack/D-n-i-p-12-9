// Phase 13 — Affiliate & Membership Models
// --------------------------------------------------------

enum SubscriptionTier {
  STARTER
  PRO
  AGENCY
  ALL_ACCESS
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ReferralStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  REJECTED
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  CRYPTO
}

model SubscriptionPlan {
  id                      String           @id @default(uuid())
  name                    String
  slug                    String           @unique
  description             String?
  tier                    SubscriptionTier
  interval                BillingInterval  @default(MONTHLY)
  priceMinor              Int              @map("price_minor")
  currency                Currency         @default(USD)
  dailyDownloadQuota      Int              @default(10) @map("daily_download_quota")
  maxActivationsPerProduct Int             @default(1) @map("max_activations_per_product")
  stripePriceId           String?          @map("stripe_price_id")
  features                Json?
  isActive                Boolean          @default(true) @map("is_active")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  subscriptions           Subscription[]

  @@index([slug])
  @@index([tier])
  @@index([isActive])
  @@map("subscription_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  planId               String             @map("plan_id")
  status               SubscriptionStatus @default(INCOMPLETE)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodStart   DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd     DateTime           @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  endedAt              DateTime?          @map("ended_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements         Entitlement[]

  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

model AffiliateAccount {
  id                   String           @id @default(uuid())
  userId               String           @unique @map("user_id")
  code                 String           @unique
  status               AffiliateStatus  @default(PENDING)
  commissionRateBp     Int              @default(2000) @map("commission_rate_bp")
  payoutMethod         PayoutMethod     @default(BANK_TRANSFER) @map("payout_method")
  payoutDetails        Json?            @map("payout_details")
  totalEarnedMinor     BigInt           @default(0) @map("total_earned_minor")
  pendingBalanceMinor  BigInt           @default(0) @map("pending_balance_minor")
  availableBalanceMinor BigInt          @default(0) @map("available_balance_minor")
  withdrawnBalanceMinor BigInt          @default(0) @map("withdrawn_balance_minor")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clicks               AffiliateClick[]
  referrals            AffiliateReferral[]
  payouts              AffiliatePayout[]

  @@index([code])
  @@index([status])
  @@map("affiliate_accounts")
}

model AffiliateClick {
  id             String           @id @default(uuid())
  affiliateId    String           @map("affiliate_id")
  userId         String?          @map("user_id")
  ipHash         String           @map("ip_hash")
  userAgentHash  String           @map("user_agent_hash")
  referer        String?
  landingPage    String           @map("landing_page")
  utmSource      String?          @map("utm_source")
  utmCampaign    String?          @map("utm_campaign")
  createdAt      DateTime         @default(now()) @map("created_at")

  affiliate      AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([affiliateId])
  @@index([ipHash])
  @@index([createdAt])
  @@map("affiliate_clicks")
}

model AffiliateReferral {
  id                   String           @id @default(uuid())
  affiliateId          String           @map("affiliate_id")
  orderId              String           @unique @map("order_id")
  customerUserId       String           @map("customer_user_id")
  orderAmountMinor     Int              @map("order_amount_minor")
  commissionAmountMinor Int             @map("commission_amount_minor")
  status               ReferralStatus   @default(PENDING)
  matureAt             DateTime         @map("mature_at")
  approvedAt           DateTime?        @map("approved_at")
  rejectedAt           DateTime?        @map("rejected_at")
  rejectionReason      String?          @map("rejection_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  affiliate            AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer             User             @relation(fields: [customerUserId], references: [id], onDelete: Restrict)

  @@index([affiliateId])
  @@index([status])
  @@index([matureAt])
  @@index([customerUserId])
  @@map("affiliate_referrals")
}

model AffiliatePayout {
  id                   String           @id @default(uuid())
  affiliateId          String           @map("affiliate_id")
  amountMinor          Int              @map("amount_minor")
  currency             Currency         @default(USD)
  status               PayoutStatus     @default(REQUESTED)
  payoutMethod         PayoutMethod     @map("payout_method")
  payoutDetailsSnapshot Json            @map("payout_details_snapshot")
  referenceCode        String?          @map("reference_code")
  requestedAt          DateTime         @default(now()) @map("requested_at")
  processedAt          DateTime?        @map("processed_at")
  processedBy          String?          @map("processed_by")
  rejectionReason      String?          @map("rejection_reason")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  affiliate            AffiliateAccount @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_payouts")
}

// --------------------------------------------------------
// Phase 14 — Hosting & Infrastructure Provisioning Models
// --------------------------------------------------------

enum HostingProvider {
  CPANEL
  DIRECTADMIN
  CLOUDFLARE
  MOCK
}

enum HostingAccountStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  TERMINATED
  FAILED
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  TXT
  MX
  NS
  SRV
}

enum DnsRecordStatus {
  PENDING
  ACTIVE
  ERROR
  DELETED
}

model HostingServer {
  id                 String          @id @default(uuid())
  name               String
  hostname           String          @unique
  provider           HostingProvider @default(MOCK)
  endpointUrl        String          @map("endpoint_url")
  ipAddress          String          @map("ip_address")
  maxAccounts        Int             @default(100) @map("max_accounts")
  activeAccounts     Int             @default(0) @map("active_accounts")
  authEncryptedToken String          @map("auth_encrypted_token")
  isActive           Boolean         @default(true) @map("is_active")
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  accounts           HostingAccount[]

  @@index([provider])
  @@index([isActive])
  @@map("hosting_servers")
}

model HostingAccount {
  id               String               @id @default(uuid())
  userId           String               @map("user_id")
  serverId         String               @map("server_id")
  entitlementId    String?              @unique @map("entitlement_id")
  orderId          String?              @map("order_id")
  domain           String               @unique
  username         String               @unique
  packagePlan      String               @default("default") @map("package_plan")
  status           HostingAccountStatus @default(PROVISIONING)
  diskUsageMb      Int                  @default(0) @map("disk_usage_mb")
  diskLimitMb      Int                  @default(5120) @map("disk_limit_mb")
  bandwidthUsageMb Int                  @default(0) @map("bandwidth_usage_mb")
  bandwidthLimitMb Int                  @default(51200) @map("bandwidth_limit_mb")
  suspendedAt      DateTime?            @map("suspended_at")
  suspensionReason String?              @map("suspension_reason")
  terminatedAt     DateTime?            @map("terminated_at")
  metadata         Json?
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  user             User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  server           HostingServer        @relation(fields: [serverId], references: [id], onDelete: Restrict)
  entitlement      Entitlement?         @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  order            Order?               @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dnsRecords       HostingDnsRecord[]

  @@index([userId])
  @@index([serverId])
  @@index([status])
  @@index([domain])
  @@map("hosting_accounts")
}

model HostingDnsRecord {
  id                 String          @id @default(uuid())
  hostingAccountId   String          @map("hosting_account_id")
  type               DnsRecordType
  name               String
  content            String
  ttl                Int             @default(3600)
  priority           Int?
  proxied            Boolean         @default(false)
  cloudflareRecordId String?         @map("cloudflare_record_id")
  status             DnsRecordStatus @default(ACTIVE)
  metadata           Json?
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  hostingAccount     HostingAccount  @relation(fields: [hostingAccountId], references: [id], onDelete: Cascade)

  @@index([hostingAccountId])
  @@index([name])
  @@index([type])
  @@index([status])
  @@map("hosting_dns_records")
}

// --------------------------------------------------------
// Phase 15 — Customer Support Helpdesk, Ticketing & Notifications
// --------------------------------------------------------

enum TicketPriority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  WAITING_CUSTOMER
  WAITING_STAFF
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketSenderType {
  CUSTOMER
  STAFF
  SYSTEM
}

enum NotificationType {
  ORDER_CONFIRMED
  LICENSE_EXPIRING
  TICKET_UPDATE
  SECURITY_ALERT
  SYSTEM_ANNOUNCEMENT
  TICKET_CREATED
  TICKET_REPLIED
  TICKET_RESOLVED
  TICKET_CLOSED
  SYSTEM_ALERT
  PROMOTION
  BILLING
}

model Ticket {
  id              String         @id @default(uuid())
  ticketNumber    String         @unique @map("ticket_number")
  userId          String         @map("user_id")
  assignedAdminId String?        @map("assigned_admin_id")
  subject         String
  category        String         @default("GENERAL")
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  orderId         String?        @map("order_id")
  entitlementId   String?        @map("entitlement_id")
  metadata        Json?
  closedAt        DateTime?      @map("closed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user            User           @relation("UserTickets", fields: [userId], references: [id], onDelete: Restrict)
  assignedAdmin   User?          @relation("AssignedAdminTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  entitlement     Entitlement?   @relation(fields: [entitlementId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]

  @@index([userId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([ticketNumber])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id             String           @id @default(uuid())
  ticketId       String           @map("ticket_id")
  senderId       String           @map("sender_id")
  senderType     TicketSenderType @map("sender_type")
  isInternalNote Boolean          @default(false) @map("is_internal_note")
  body           String
  createdAt      DateTime         @default(now()) @map("created_at")

  ticket         Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  attachments    TicketAttachment[]

  @@index([ticketId])
  @@index([senderId])
  @@index([isInternalNote])
  @@index([createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String        @id @default(uuid())
  messageId  String        @map("message_id")
  fileName   String        @map("file_name")
  storageKey String        @map("storage_key")
  mimeType   String        @map("mime_type")
  sizeBytes  Int           @map("size_bytes")
  sha256     String
  createdAt  DateTime      @default(now()) @map("created_at")

  message    TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("ticket_attachments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  actionUrl String?          @map("action_url")
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

