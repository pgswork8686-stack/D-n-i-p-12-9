# /etc/nexustheme/backup.env  (chmod 600)
DB_ACCESS_MODE=compose
COMPOSE_ENV_FILE=/opt/nexustheme/.env.production
# Generate once:  openssl rand -base64 48 > /etc/nexustheme/backup.key && chmod 400 /etc/nexustheme/backup.key
# STORE A COPY OF THIS KEY OUTSIDE THE SERVER (password manager / sealed envelope). Lose it and every backup is unreadable.
BACKUP_ENCRYPTION_KEY_FILE=/etc/nexustheme/backup.key
BACKUP_RETENTION_DAYS=30
# Offsite: an S3-compatible bucket (Cloudflare R2 / Backblaze B2) and/or a mounted directory.
BACKUP_R2_BUCKET=
STORAGE_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BACKUP_OFFSITE_DIR=
# The monthly drill reads the offsite copy:
DRILL_MAX_SECONDS=1800
