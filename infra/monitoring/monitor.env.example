# /etc/nexustheme/monitor.env  (chmod 600) — copy and fill in; no real secrets belong in git.
MONITOR_HOST_LABEL=nexustheme-staging
MONITOR_URLS=api=http://127.0.0.1:4000/health/readiness,web=https://staging.example.com/,portal=https://portal.staging.example.com/login,admin=https://admin.staging.example.com/login
BACKUP_DIR=/var/backups/nexustheme
BACKUP_MAX_AGE_HOURS=26
DISK_PATHS=/,/var/lib/docker
DISK_MAX_PERCENT=85
TLS_HOSTS=staging.example.com
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
