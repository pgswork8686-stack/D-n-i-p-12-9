{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Maintenance window: create infra/docker/flags/maintenance.on to serve 503.
# The API stays reachable so payment webhooks keep being recorded.
(maintenance) {
	@maintenance file {
		root /srv/flags
		try_files /maintenance.on
	}
	handle @maintenance {
		header Retry-After 900
		header Content-Type "text/plain; charset=utf-8"
		respond "NexusTheme đang bảo trì, vui lòng quay lại sau ít phút." 503
	}
}

{$WEB_DOMAIN} {
	import common
	import maintenance
	reverse_proxy web:3000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$PORTAL_DOMAIN} {
	import common
	import maintenance
	reverse_proxy portal:3001
}

{$ADMIN_DOMAIN} {
	import common
	import maintenance
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy admin:3002
}

{$API_DOMAIN} {
	import common

	# Request-body ceilings per endpoint (F-08). Caddy sizes use SI units for "MB" and binary
	# units for "MiB"; MiB is used so the numbers match the application limits exactly.
	# Layers: this edge limit -> maxRequestBytes guard (413 on Content-Length) -> Multer limits.
	# Keep the three in step with SERVICE_FILE_MAX_BYTES / SERVICE_INQUIRY_MAX_FILES (contracts)
	# and MAX_UPLOAD_BYTES (admin version files).

	# Public inquiry form: 5 files x 10 MiB + 2 MiB of fields, plus 1 MiB of slack.
	@service_inquiry_form path /v1/service-inquiries
	handle @service_inquiry_form {
		request_body {
			max_size 53MiB
		}
		reverse_proxy api:4000
	}

	# Service project documents (customer and staff): one 10 MiB file + 2 MiB, plus 1 MiB of slack.
	@service_documents path_regexp ^/v1/(me|admin)/service-projects/[^/]+/documents$
	handle @service_documents {
		request_body {
			max_size 13MiB
		}
		reverse_proxy api:4000
	}

	# Admin product-version file upload (large release archives).
	@version_upload path_regexp ^(/v1)?/admin/product-versions/[^/]+/files/upload$
	handle @version_upload {
		request_body {
			max_size 60MiB
		}
		reverse_proxy api:4000
	}

	# Everything else is JSON. Payment webhooks need the untouched raw body but are tiny.
	handle {
		request_body {
			max_size 5MiB
		}
		reverse_proxy api:4000
	}
}