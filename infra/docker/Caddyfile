{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$WEB_DOMAIN} {
	import common
	reverse_proxy web:3000
}

www.{$WEB_DOMAIN} {
	redir https://{$WEB_DOMAIN}{uri} permanent
}

{$PORTAL_DOMAIN} {
	import common
	reverse_proxy portal:3001
}

{$ADMIN_DOMAIN} {
	import common
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy admin:3002
}

{$API_DOMAIN} {
	import common
	# Payment webhooks need the untouched raw body; keep request size bounded.
	request_body {
		max_size 60MB
	}
	reverse_proxy api:4000
}
