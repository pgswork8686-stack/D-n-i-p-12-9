# Phase 19 — Superset environment (copy to infra/superset/.env, which is gitignored).
# Every value below is a placeholder; Superset refuses to start with an empty/placeholder secret.

SUPERSET_ENV=development
# 32+ random characters, e.g. `openssl rand -base64 48`
SUPERSET_SECRET_KEY=
SUPERSET_METADATA_DB_PASSWORD=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=

# Read-only role created by infra/superset/sql/create-readonly-role.sql
ANALYTICS_RO_PASSWORD=
# postgresql+psycopg2://superset_ro:<ANALYTICS_RO_PASSWORD>@host.docker.internal:5432/marketplace
ANALYTICS_DATABASE_URI=
