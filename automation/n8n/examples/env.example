# NEXUSTHEME n8n Automation Environment Configuration
# NEVER commit real values or secrets to source control!

# Nexus Internal API Base URL (HTTPS required in production)
NEXUS_API_BASE_URL=https://api.domain.com

# Shared HMAC secret for signing internal callbacks to /v1/internal/automation/*
AUTOMATION_SERVICE_SECRET=your_32_character_hmac_secret_here

# External AI Provider (OpenAI / Anthropic)
OPENAI_API_KEY=your_openai_api_key_here

# External Email Provider (Resend / SendGrid / Postmark)
RESEND_API_KEY=your_resend_api_key_here
TRANSACTIONAL_FROM_EMAIL=orders@domain.com

# Code nodes need these to verify HMAC and reach the replay-guard Redis
NODE_FUNCTION_ALLOW_BUILTIN=crypto,net
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Replay guard (required, no default): a Redis dedicated to this n8n, reachable from the n8n container.
# Plain TCP only (no TLS / rediss), single-argument AUTH (no ACL username). Set the password only if that
# Redis has requirepass: a password against a Redis without one makes every dispatch fail closed.
N8N_REPLAY_REDIS_HOST=n8n-replay-redis
N8N_REPLAY_REDIS_PORT=6379
N8N_REPLAY_REDIS_PASSWORD=your_replay_redis_password_here
