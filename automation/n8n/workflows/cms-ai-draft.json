{
  "name": "NEXUSTHEME — CMS AI Draft Generation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cms-ai-draft",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENAI_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o"
            },
            {
              "name": "response_format",
              "value": "{\"type\":\"json_object\"}"
            }
          ]
        },
        "options": {}
      },
      "id": "ai-generate-node",
      "name": "Generate Structured Article",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.AUTOMATION_SERVICE_SECRET;\nconst jobId = $('Webhook Trigger').first().json.body.jobId;\nconst aiContent = JSON.parse($input.first().json.choices[0].message.content);\n\nconst body = {\n  jobId,\n  result: {\n    title: aiContent.title,\n    excerpt: aiContent.excerpt,\n    content: aiContent.content,\n    seoTitle: aiContent.seoTitle,\n    seoDescription: aiContent.seoDescription,\n    suggestedSlug: aiContent.suggestedSlug\n  }\n};\n\nconst timestamp = Date.now().toString();\nconst requestId = 'cb-' + jobId + '-' + timestamp;\nconst path = '/v1/internal/automation/content-ai-draft-result';\nconst rawBody = JSON.stringify(body);\nconst bodyHash = crypto.createHash('sha256').update(rawBody).digest('hex');\nconst canonical = ['POST', path, timestamp, requestId, bodyHash].join('\\n');\nconst signature = crypto.createHmac('sha256', secret).update(canonical).digest('hex');\n\nreturn [{\n  json: {\n    body,\n    headers: {\n      'Content-Type': 'application/json',\n      'X-Nexus-Service': 'n8n',\n      'X-Nexus-Timestamp': timestamp,\n      'X-Nexus-Request-Id': requestId,\n      'X-Nexus-Signature': signature\n    }\n  }\n}];"
      },
      "id": "sign-callback-node",
      "name": "Sign Callback Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NEXUS_API_BASE_URL }}/v1/internal/automation/content-ai-draft-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Nexus-Service",
              "value": "={{ $json.headers['X-Nexus-Service'] }}"
            },
            {
              "name": "X-Nexus-Timestamp",
              "value": "={{ $json.headers['X-Nexus-Timestamp'] }}"
            },
            {
              "name": "X-Nexus-Request-Id",
              "value": "={{ $json.headers['X-Nexus-Request-Id'] }}"
            },
            {
              "name": "X-Nexus-Signature",
              "value": "={{ $json.headers['X-Nexus-Signature'] }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {}
      },
      "id": "callback-node",
      "name": "Nexus Callback (Save AI Draft)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [950, 300]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Generate Structured Article",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Structured Article": {
      "main": [
        [
          {
            "node": "Sign Callback Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign Callback Payload": {
      "main": [
        [
          {
            "node": "Nexus Callback (Save AI Draft)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
