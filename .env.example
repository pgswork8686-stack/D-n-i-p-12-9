# Environment Configuration for NEXUSTHEME Platform
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marketplace

# Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379

# Local Storage (MinIO / S3 compatible)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=marketplace-dev
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=auto

# Application URLs
WEB_URL=http://localhost:3000
PORTAL_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000

# Client Browser Environment Variables (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# Authentication (Supabase Auth - Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development Auth & Seed Controls (Local only, fail-closed in production)
SEED_DEV_USERS=false
NEXT_PUBLIC_ENABLE_DEV_AUTH_TOOLS=false

# Phase 4 Test Payment Provider (Development / Test only, fail-closed in production)
ENABLE_TEST_PAYMENT_PROVIDER=false
TEST_PAYMENT_WEBHOOK_SECRET=change-me-local-only

# Phase 7 Internal License Key Encryption (32-byte hex key, REQUIRED)
LICENSE_KEY_ENCRYPTION_KEY=

# Phase 9 Production Payment Gateway (Stripe)
# Required in production: official Stripe secret key, webhook signing secret,
# and an HTTPS customer/portal origin for provider return URLs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RETURN_BASE_URL=http://localhost:3001
# Optional additional trusted absolute redirect origins, comma-separated.
ALLOWED_REDIRECT_ORIGINS=
# Local/Test mock mode only. MUST NOT be true in production (fail-closed check enforced).
STRIPE_MOCK_CLIENT=false


# Phase 19 — AI Marketing OS & Analytics
# Model provider: none (default, deterministic workflows only) | openai | anthropic.
# Keys are server-side only. NEVER put them in NEXT_PUBLIC_* variables (the API refuses to start the AI feature).
# In production a provider without a real key disables the AI feature (fail-closed, HTTP 503).
AI_PROVIDER=none
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=30000
# Max AI workflow executions per user per hour.
AI_MAX_EXECUTIONS_PER_HOUR=20
# Optional: absolute path to ai/skills when the API runs outside the repository layout (e.g. Docker image).
AI_SKILLS_DIR=
# Optional: absolute path to ai/contexts/system.json for db:seed:system.
AI_SYSTEM_CONTEXT_FILE=
# Analytics ingestion (POST /internal/analytics/ingest) reuses AUTOMATION_SERVICE_SECRET (HMAC, >= 32 chars).
# Apache Superset settings live in infra/superset/.env (see infra/superset/README.md).

# Phase 12 automation (was missing from this file): HMAC secret shared by API, worker and n8n
# (>= 32 chars, no placeholder in production) and the n8n webhook base URL used by the worker.
AUTOMATION_SERVICE_SECRET=
N8N_WEBHOOK_BASE_URL=http://localhost:5678
