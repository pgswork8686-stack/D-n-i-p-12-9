# =============================================================================
# NexusTheme — PRODUCTION environment
# Copy to .env.production (git-ignored) and fill in EVERY value.
#   docker compose -f infra/docker/production-compose.yml --env-file .env.production up -d --build
# Generate secrets with:  openssl rand -hex 32
# =============================================================================
NODE_ENV=production

# --- Domains (Caddy issues HTTPS certificates automatically) -----------------
WEB_DOMAIN=nexustheme.vn
PORTAL_DOMAIN=app.nexustheme.vn
ADMIN_DOMAIN=admin.nexustheme.vn
API_DOMAIN=api.nexustheme.vn
ACME_EMAIL=admin@nexustheme.vn

# --- Database / Redis (private network only) ---------------------------------
POSTGRES_USER=nexus
POSTGRES_PASSWORD=
POSTGRES_DB=marketplace
REDIS_PASSWORD=

# --- Auth: Supabase (https://supabase.com → Project Settings → API) ----------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Secrets ------------------------------------------------------------------
# 64 hex chars (32 bytes). NEVER change after go-live: existing license keys
# become undecryptable.
LICENSE_KEY_ENCRYPTION_KEY=
# >= 32 chars. Only needed when FEATURE_HOSTING=true.
HOSTING_ENCRYPTION_KEY=
# >= 32 chars. Shared HMAC secret between worker/API and n8n.
AUTOMATION_SERVICE_SECRET=

# --- Private file storage: Cloudflare R2 (S3 compatible) ---------------------
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_BUCKET=nexustheme-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
# Max admin upload size in bytes (default 50MB). Keep <= Caddy request_body.
MAX_UPLOAD_BYTES=52428800

# --- Payments: SePay / VietQR (https://my.sepay.vn) --------------------------
# Bank short code as used by qr.sepay.vn (e.g. MBBank, Vietcombank, ACB, TPBank)
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
# Webhook URL to register in SePay:  https://<API_DOMAIN>/v1/webhooks/payments/sepay
# Auth type "API Key"; paste the same value here (>= 24 chars).
SEPAY_WEBHOOK_API_KEY=
# Optional: SePay user API token, enables the "Tôi đã chuyển khoản" instant check.
SEPAY_API_TOKEN=
# Transfer-code prefix (2-6 letters). Configure the same prefix in SePay
# "Cấu hình mã thanh toán" so SePay extracts it into the `code` field.
SEPAY_PAYMENT_CODE_PREFIX=NXS

# --- Payments: Stripe (optional; leave BOTH empty to disable) ----------------
# Must be a live key (sk_live_) in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Customers return to the storefront order page after Stripe Checkout.
PAYMENT_RETURN_BASE_URL=https://nexustheme.vn

# --- Feature flags (unfinished modules stay OFF until completed) ------------
FEATURE_HOSTING=false
FEATURE_MEMBERSHIP=false
FEATURE_AFFILIATE=false
FEATURE_FINANCE=false

# --- Automation: n8n (optional) -----------------------------------------------
N8N_WEBHOOK_BASE_URL=
N8N_DISABLED_JOB_TYPES=

# --- Hard safety switches: must stay false/empty in production ---------------
ENABLE_TEST_PAYMENT_PROVIDER=false
STRIPE_MOCK_CLIENT=false
SEED_DEV_USERS=false
NEXT_PUBLIC_ENABLE_DEV_AUTH_TOOLS=false
